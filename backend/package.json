{
  "name": "agent-orchestrator-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate-comandos": "knex --knexfile knexfileComandos.js migrate:latest",
    "migrate-comandos:rollback": "knex --knexfile knexfileComandos.js migrate:rollback",
    "migrate-comandos:data": "node scripts/migrarComandos.js",
    "migrate-config": "knex --knexfile knexfileConfig.js migrate:latest",
    "migrate-config:rollback": "knex --knexfile knexfileConfig.js migrate:rollback",
    "migrate-config:data": "node scripts/migrarConfig.js",
    "migrate-config-all:data": "node scripts/migrarConfigAll.js",
    "seed": "knex seed:run",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "dev:all": "concurrently -n back,front -c cyan,magenta \"npm run dev\" \"npm run dev --prefix ../frontend\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "node-pty": "^1.1.0",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
