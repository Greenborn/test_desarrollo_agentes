# Copiar a .env (no versionar .env).
VITE_BACKEND_URL=http://localhost:4000
VITE_PROCESOS_CONSOLA_PORT=3575

# Reporte contextual (notas de desarrollo en el SGI). Si falta VITE_SGI_API_URL o
# VITE_SGI_PROYECTO_SLUG, el reporte no se monta.
# Base de la API del SGI (endpoint público). Para pruebas locales no apuntar a producción.
VITE_SGI_API_URL=
# Slug del proyecto registrado en la tabla `proyectos` del SGI.
VITE_SGI_PROYECTO_SLUG=
# Versión precompletada en el reporte (opcional).
VITE_REPORTE_VERSION=
